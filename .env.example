# ============================================
# Environment Variables for TodoApp
# Copy this file to .env and fill in your values
# ============================================

# GOOGLE GEMINI API KEY (Required)
# Get from: https://aistudio.google.com
GOOGLE_API_KEY=your_google_gemini_api_key_here

# DATABASE URL (Optional)
# Default: SQLite (./test.db)
# For PostgreSQL: postgresql://user:password@localhost:5432/tododb
# For MySQL: mysql+pymysql://user:password@localhost:3306/tododb
# DATABASE_URL=sqlite:///./test.db

# JWT SECRET KEY (Optional)
# Change this to a secure random string in production
# SECRET_KEY=your_super_secret_key_change_this_in_production

# ============================================
# Optional: Database Credentials (if using PostgreSQL/MySQL)
# ============================================
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=tododb

# ============================================
# Optional: Logging
# ============================================
# LOG_LEVEL=INFO

